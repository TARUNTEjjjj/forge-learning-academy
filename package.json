{
  "name": "forge-free-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "stage:python": "node scripts/stage-python-runtime.mjs",
    "predev": "npm run stage:python && npm run resources:stage",
    "prebuild": "npm run stage:python && npm run resources:stage",
    "test:browser": "node tests/python-browser.mjs",
    "resources:stage": "node scripts/stage-resource-explorer.mjs public/resources",
    "test:resources:ui": "node --test scripts/resource-explorer.test.mjs",
    "resources:refresh": "node scripts/resources/resource-server.mjs refresh --config resources/sources.json --output resources/catalog.json",
    "resources:serve": "node scripts/resources/resource-server.mjs serve --config resources/sources.json --snapshot resources/catalog.json",
    "test:resources": "node --test scripts/resources/resource-catalog.test.mjs && node scripts/resources/check-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "pyodide": "314.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
